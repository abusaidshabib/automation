# ─────────────────────────────────────────────
#  YouTube Downloader — Example Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Paste your playlist or single video URL here
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxx

# Folder where videos will be saved (absolute or relative path)
SAVE_PATH=./downloads

# Set to true to download audio only (saves as MP3)
AUDIO_ONLY=false

# Video quality: best | 1080 | 720 | 480 | 360
VIDEO_QUALITY=best

# Skip files that already exist in the save folder (true/false)
SKIP_EXISTING=true
