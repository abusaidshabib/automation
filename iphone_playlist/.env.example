# ─────────────────────────────────────────────
#  iPhone Playlist Audio — Example Configuration
#  Copy to .env and edit. CLI flags always win.
# ─────────────────────────────────────────────

# Playlist or single video URL (optional if playlist_url.txt is set)
# PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxx

# Parent folder for downloads (a subfolder named after the playlist is created)
SAVE_PATH=./iphone_playlist/downloads

# Output codec: alac | aac | flac | wav
#   alac — Apple Lossless (default). Best for iPhone Music / Files. No second lossy encode.
#   aac  — 256 kbps AAC in .m4a. Smaller files; fine for Bluetooth. Second lossy encode.
#   flac — Lossless. Larger; use Files or a third-party app on iPhone.
#   wav  — Uncompressed PCM. Largest.
OUTPUT_FORMAT=alac

# yt-dlp format selector for the YouTube stream (usually Opus is best)
SOURCE_FORMAT=bestaudio/best

# ALAC sample bit depth: 24 (default) or 16. Sample rate follows the source (no upsample).
ALAC_BIT_DEPTH=24

# Skip tracks already in the download archive / on disk (true/false)
SKIP_EXISTING=true

# Clean YouTube titles for filenames and tags (true/false)
CLEAN_TITLES=true

# Write title / artist / album / track tags (true/false)
EMBED_METADATA=true

# Embed the video thumbnail as cover art (true/false; alac/aac/flac only)
EMBED_ART=true

# Optional: cookies when YouTube blocks anonymous downloads (pick one)
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=/path/to/cookies.txt
